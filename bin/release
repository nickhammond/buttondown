#!/usr/bin/env bash
set -euo pipefail

# Usage: bin/release 0.1.1
#
# Runs every check, then bumps the version, tags it, and pushes the gem to
# RubyGems. Everything before the "Releasing" line is reversible; stop there
# if anything looks wrong. A pushed gem version cannot be replaced.

VERSION="${1:-}"

die() { printf '\033[31m%s\033[0m\n' "$1" >&2; exit 1; }
step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }

[ -n "$VERSION" ] || die "Usage: bin/release <version>   e.g. bin/release 0.1.1"

[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+(\.[a-z0-9]+)?$ ]] ||
  die "'$VERSION' is not a version number, e.g. 0.1.1 or 0.2.0.rc1"

step "Preflight"

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
[ "$BRANCH" = "main" ] || die "On '$BRANCH'. Releases go out from main."

[ -z "$(git status --porcelain)" ] || die "Working tree is dirty. Commit or discard first."

git fetch --quiet origin main
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] ||
  die "main and origin/main differ. Pull or push first."

# `gem release` reads the API key from here. Without it the push fails after
# the tag is already public, which is an awkward place to stop.
[ -f "$HOME/.gem/credentials" ] ||
  die "No ~/.gem/credentials. Run 'gem signin' first."

git rev-parse --verify --quiet "refs/tags/v$VERSION" >/dev/null &&
  die "Tag v$VERSION already exists."

grep -q "^## $VERSION" CHANGELOG.md ||
  die "CHANGELOG.md has no '## $VERSION' section. Write the release notes first."

echo "main, clean, in sync, credentials present, CHANGELOG ready."

step "Checks"
bin/ci

CURRENT="$(ruby -r ./lib/buttondown/version -e 'print Buttondown::VERSION')"

if [ "$CURRENT" = "$VERSION" ]; then
  # First release, or the bump was already committed. `gem bump` would try an
  # empty commit here and fail.
  step "Version is already $VERSION, nothing to bump"
else
  step "Bumping $CURRENT -> $VERSION"
  bundle exec gem bump --version "$VERSION" --no-push
  git push origin main
fi

step "Tagging v$VERSION"
bundle exec gem tag --push

step "Releasing $VERSION to RubyGems"
bundle exec gem release

printf '\n\033[32mReleased %s.\033[0m\n' "$VERSION"
